{
  "name": "pano-view-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @pano-view/playground dev",
    "build": "pnpm --filter @pano-view/react build && pnpm --filter @pano-view/playground build",
    "typecheck": "pnpm --filter @pano-view/react typecheck && pnpm --filter @pano-view/playground typecheck",
    "pack:check": "pnpm --filter @pano-view/react exec env npm_config_cache=../../.npm-cache npm pack --dry-run"
  }
}
