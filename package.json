{
  "name": "pano-view-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @pano-view/playground dev",
    "build": "pnpm --filter @ericchen1990/pano-view build && pnpm --filter @pano-view/playground build",
    "typecheck": "pnpm --filter @ericchen1990/pano-view typecheck && pnpm --filter @pano-view/playground typecheck",
    "pack:check": "pnpm --filter @ericchen1990/pano-view exec env npm_config_cache=../../.npm-cache npm pack --dry-run"
  }
}
