{
  "name": "@ericchen1990/pano-editor",
  "version": "1.0.0",
  "description": "Embeddable React panorama authoring with local project editing and host-owned conversion.",
  "license": "MIT",
  "author": "Eric Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Chen1990/pano-view.git",
    "directory": "packages/editor"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "@ericchen1990/pano-view": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @ericchen1990/pano-view build && tsup --config test/tsup.config.ts && node --test .test-dist/*.js",
    "pack:check": "pnpm pack --dry-run && node test/pack-smoke.mjs"
  },
  "devDependencies": {
    "@ericchen1990/pano-view": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
