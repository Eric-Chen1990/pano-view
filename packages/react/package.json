{
  "name": "@ericchen1990/pano-view",
  "version": "3.6.1",
  "description": "React components for panoramic viewing experiences.",
  "author": "Eric Chen",
  "license": "MIT",
  "keywords": [
    "panorama",
    "360",
    "react",
    "viewer",
    "webgl",
    "react-three-fiber",
    "r3f",
    "360-image",
    "virtual-tour",
    "equirectangular",
    "cubemap",
    "webxr",
    "krpano",
    "panoramic-video"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Chen1990/pano-view.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Eric-Chen1990/pano-view/issues"
  },
  "homepage": "https://pano-view-playground.vercel.app/",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.mjs",
      "require": "./dist/data.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.cjs"
    },
    "./ui/styles.css": "./dist/ui/styles.css"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@types/three": "^0.185.0",
    "howler": "^2.2.4"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsup && node -e \"const fs=require('node:fs');fs.copyFileSync('src/styles.css','dist/styles.css');fs.mkdirSync('dist/ui',{recursive:true});fs.copyFileSync('src/ui/styles.css','dist/ui/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "tsup --config test/tsup.config.ts && node --test .test-dist/*.js",
    "pack:check": "npm pack --dry-run && node test/pack-smoke.mjs"
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
