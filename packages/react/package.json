{
  "name": "@ericchen1990/pano-view",
  "version": "2.3.0",
  "description": "React components for panoramic viewing experiences.",
  "author": "Eric Chen",
  "license": "MIT",
  "keywords": [
    "panorama",
    "360",
    "react",
    "viewer",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Chen1990/pano-view.git"
  },
  "bugs": {
    "url": "https://github.com/Eric-Chen1990/pano-view/issues"
  },
  "homepage": "https://github.com/Eric-Chen1990/pano-view#readme",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "howler": "^2.2.4"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.0",
    "react": ">=19.0.0 <19.3.0",
    "react-dom": ">=19.0.0 <19.3.0",
    "three": "^0.185.1"
  },
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
