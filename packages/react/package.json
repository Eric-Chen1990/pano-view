{
  "name": "@pano-view/react",
  "version": "0.0.0",
  "description": "React components for panoramic viewing experiences.",
  "author": "Eric Chen",
  "license": "MIT",
  "keywords": [
    "panorama",
    "360",
    "react",
    "viewer",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Chen1990/pano-view.git"
  },
  "bugs": {
    "url": "https://github.com/Eric-Chen1990/pano-view/issues"
  },
  "homepage": "https://github.com/Eric-Chen1990/pano-view#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@types/three": "^0.185.0"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": ">=19.0.0 <19.3.0",
    "react-dom": ">=19.0.0 <19.3.0",
    "three": "^0.185.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
